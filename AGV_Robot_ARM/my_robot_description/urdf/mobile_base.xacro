<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >

  <xacro:property name="base_length" value="0.7" />
  <xacro:property name="base_width" value="0.45" />
  <xacro:property name="base_height" value="0.18" />
  <xacro:property name="wheel_radius" value="0.10" />
  <xacro:property name="wheel_length" value="0.06" />

  <link name="base_footprint" />

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0" />
      <material name="dark_blue" />
    </visual>

    <visual>
      <geometry>
        <box size="${base_length * 0.82} ${base_width * 0.76} ${base_height * 0.18}"/>
      </geometry>
      <origin xyz="0 0 ${base_height + base_height * 0.09}" rpy="0 0 0" />
      <material name="light_grey" />
    </visual>

    <visual>
      <geometry>
        <box size="${base_length * 0.14} ${base_width * 0.90} ${base_height * 0.22}"/>
      </geometry>
      <origin xyz="${base_length * 0.25} 0 ${base_height * 0.60}" rpy="0 0 0" />
      <material name="black" />
    </visual>
    
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <origin xyz="0 0 ${base_height / 2.0}" rpy="0 0 0" />
    </collision>

    <xacro:box_inertia m="5.0" x="${base_length}" y="${base_width}" z="${base_height}"
                       o_xyz="0 0 ${base_height / 2.0}" o_rpy="0 0 0" />
  </link>

  <xacro:macro name="wheel_link" params="prefix">
  <link name="${prefix}_wheel_link">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
      <material name="dark_grey" />
    </visual>

    <visual>
      <geometry>
        <cylinder radius="${wheel_radius * 0.72}" length="${wheel_length * 0.18}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
      <material name="light_grey" />
    </visual>

    <collision>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
    </collision>

    <xacro:cylinder_inertia m="1.0" r="${wheel_radius}" h="${wheel_length}"
                            o_xyz="0 0 0" o_rpy="${pi / 2.0} 0 0" />
  </link>
  </xacro:macro>

  <xacro:wheel_link prefix="left" />
  <xacro:wheel_link prefix="right" />

  <link name="caster_wheel_link">
    <visual>
      <geometry>
        <sphere radius="${wheel_radius / 2.0}" />
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <material name="dark_grey" />
    </visual>

    <collision>
      <geometry>
        <sphere radius="${wheel_radius / 2.0}" />
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0" />
    </collision>

    <xacro:sphere_inertia m="0.5" r="${wheel_radius / 2.0}" o_xyz="0 0 0" o_rpy="0 0 0" />
  </link>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <joint name="base_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <origin xyz="${-base_length / 4.0} ${(base_width + wheel_length) / 2.0} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="base_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <origin xyz="${-base_length / 4.0} ${-(base_width + wheel_length) / 2.0} 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <joint name="base_caster_wheel_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel_link"/>
    <origin xyz="${base_length / 3.0} 0 ${-wheel_radius / 2.0}" rpy="0 0 0"/>
  </joint>

</robot>