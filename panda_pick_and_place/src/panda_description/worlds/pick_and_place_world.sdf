<sdf version='1.9'>
  <world name='pick_and_place_world'>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

  <!-- ================= RED BOX ================= -->
  <model name="red_box">
    <!-- Tabletop z=0.35 plus half the box height (0.04). -->
    <pose>0.25 0.6 0.39 0 0 0</pose>
    <static>false</static>
    <link name="red_link">
      <inertial>
        <mass>0.10</mass>
        <inertia>
          <ixx>0.00011</ixx><iyy>0.00011</iyy><izz>0.00008</izz>
        </inertia>
      </inertial>
      <collision name="red_collision">
        <geometry>
          <box>
            <size>0.08 0.08 0.08</size>
          </box>
        </geometry>
      </collision>
      <visual name="red_visual">
        <geometry>
          <box>
            <size>0.08 0.08 0.08</size>
          </box>
        </geometry>
        <material>
          <ambient>1 0.05 0.05 1</ambient>
          <diffuse>1 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- ================= GREEN BOX ================= -->
  <model name="green_box">
    <!-- Tabletop z=0.35 plus half the box height (0.03). -->
    <pose>0.55 0.6 0.38 0 0 0</pose>
    <static>false</static>
    <link name="green_link">
      <inertial>
        <mass>0.12</mass>
        <inertia>
          <ixx>0.00007</ixx><iyy>0.00012</iyy><izz>0.00013</izz>
        </inertia>
      </inertial>
      <collision name="green_collision">
        <geometry>
          <box>
            <size>0.10 0.06 0.06</size>
          </box>
        </geometry>
      </collision>
      <visual name="green_visual">
        <geometry>
          <box>
            <size>0.10 0.06 0.06</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 1 0.10 1</ambient>
          <diffuse>0.05 1 0.10 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

  <!-- ================= BLUE BOX ================= -->
  <model name="blue_box">
    <!-- Tabletop z=0.35 plus half the box height (0.05). -->
    <pose>0.85 0.6 0.40 0 0 0</pose>
    <static>false</static>
    <link name="blue_link">
      <inertial>
        <mass>0.08</mass>
        <inertia>
          <ixx>0.00011</ixx><iyy>0.00009</iyy><izz>0.00007</izz>
        </inertia>
      </inertial>
      <collision name="blue_collision">
        <geometry>
          <box>
            <size>0.06 0.08 0.10</size>
          </box>
        </geometry>
      </collision>
      <visual name="blue_visual">
        <geometry>
          <box>
            <size>0.06 0.08 0.10</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.15 1 1</ambient>
          <diffuse>0.05 0.15 1 1</diffuse>
        </material>
      </visual>
    </link>
  </model>

    <!-- Open-top destination containers on the rear table, aligned by box color. -->
    <include>
      <uri>model://sorting_container</uri>
      <name>red_container</name>
      <pose>0.25 -0.56 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://sorting_container_green</uri>
      <name>green_container</name>
      <pose>0.55 -0.56 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://sorting_container_blue</uri>
      <name>blue_container</name>
      <pose>0.85 -0.56 0 0 0 0</pose>
    </include>

    <!-- Six gap-free designer tables in a 3-row x 2-column layout. -->
    <!-- Rear row (behind the Panda, replacing the trash can). -->
    <include>
      <uri>model://fancy_table</uri>
      <name>fancy_table_5</name>
      <pose>0 -0.56 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://fancy_table</uri>
      <name>fancy_table_6</name>
      <pose>1.12 -0.56 0 0 0 0</pose>
    </include>

    <!-- Middle row containing the Panda base. -->
    <include>
      <uri>model://fancy_table</uri>
      <name>fancy_table_1</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://fancy_table</uri>
      <name>fancy_table_2</name>
      <pose>1.12 0 0 0 0 0</pose>
    </include>

    <!-- Front row containing the colored boxes. -->
    <include>
      <uri>model://fancy_table</uri>
      <name>fancy_table_3</name>
      <pose>1.12 0.56 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://fancy_table</uri>
      <name>fancy_table_4</name>
      <pose>0 0.56 0 0 0 0</pose>
    </include>
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <light name='sun' type='directional'>
      <pose>0 0 10 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.90000000000000002</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
  </world>
</sdf>
