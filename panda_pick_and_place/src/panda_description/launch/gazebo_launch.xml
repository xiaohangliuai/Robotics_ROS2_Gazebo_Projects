<launch>
    <arg name="conveyor_speed" default="0.15"
        description="Conveyor surface speed in metres per second" />

    <let name="urdf_path"
        value="$(find-pkg-share panda_description)/urdf/panda_urdf.xacro" />
    <let name="rviz_config_path"
        value="$(find-pkg-share panda_description)/rviz/display.rviz" />
    <let name="world_path"
        value="$(find-pkg-share panda_description)/worlds/empty_world.sdf" />
    <let name="model_path"
        value="$(find-pkg-share panda_description)/models" />
    <let name="package_share_path"
        value="$(find-pkg-share panda_description)" />
    <let name="robot_description"
        value="$(command 'xacro $(var urdf_path) mesh_prefix:=file://$(var package_share_path)/meshes')" />

    <set_env name="GZ_SIM_RESOURCE_PATH" value="$(var model_path):$(var package_share_path)" />
    <set_env name="GAZEBO_MODEL_PATH" value="$(var model_path):$(var package_share_path)" />

    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description"
            value="$(var robot_description)" />
    </node>

    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="$(var world_path) -v 4 -r" />
    </include>

    <node pkg="ros_gz_sim" exec="create" args="-topic robot_description -name panda -x 0.0 -y 0.0 -z 0.0 -R 0.0 -P 0.0 -Y 0.0" />

    <node pkg="ros_gz_bridge" exec="parameter_bridge" args="/clock@rosgraph_msgs/msg/Clock[gz.msgs.Clock /camera/camera_info@sensor_msgs/msg/CameraInfo[gz.msgs.CameraInfo" />

    <node pkg="ros_gz_image" exec="image_bridge" args="/camera/image_raw" />

    <!-- TrackController keeps the most recent command, so one delayed command starts the belt. -->
    <timer period="3.0">
        <executable
            cmd="gz topic -t /model/conveyor/link/belt_link/track_cmd_vel -m gz.msgs.Double -p data:$(var conveyor_speed)"
            output="screen" />
    </timer>
</launch>
